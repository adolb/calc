<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>iCloud Dashboard</title>

<!-- Supabase JS Library dari CDN -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<!-- Font Awesome untuk Icon Apple Style -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
        background: linear-gradient(135deg, #3b82f6, #60a5fa, #93c5fd);
        min-height: 100vh;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .dashboard-container {
        width: 100%;
        max-width: 460px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* Gaya Kartu Utama ala iCloud */
    .icloud-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    /* Bagian Header Kartu */
    .card-header {
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.4);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Icon Aplikasi Kustom */
    .app-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }
    
    .drive-icon { background: #e0f2fe; color: #0284c7; }
    .notes-icon { background: #fef9c3; color: #ca8a04; }

    .app-info h2 {
        font-size: 20px;
        font-weight: 600;
        color: #1e293b;
    }

    .app-info span {
        font-size: 13px;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .header-right {
        color: #ca8a04;
        font-size: 18px;
        cursor: pointer;
    }

    /* Bagian Konten Kartu */
    .card-body {
        background: #ffffff;
        padding: 20px;
        min-height: 180px;
        display: flex;
        flex-direction: column;
    }

    /* KONTEN DRIVE */
    .drive-content { gap: 14px; color: #64748b; }
    .upload-zone {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 2px dashed #cbd5e1;
        border-radius: 14px;
        padding: 20px;
        cursor: pointer;
        background: #f8fafc;
        transition: 0.2s;
    }
    .upload-zone:hover { background: #f1f5f9; border-color: #3b82f6; }
    .upload-zone i { font-size: 44px; color: #3b82f6; margin-bottom: 8px; }
    .upload-zone p { font-size: 16px; font-weight: 500; }
    
    .file-list { display: flex; flex-direction: column; width: 100%; margin-top: 8px; max-height: 160px; overflow-y: auto; }
    .file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .file-item:last-child { border-bottom: none; }
    .file-item-left { display: flex; align-items: center; gap: 10px; font-size: 16px; color: #1e293b; font-weight: 500; }
    .file-item-left i { color: #64748b; }
    .download-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .download-btn:hover { background: #2563eb; }

    /* KONTEN CATATAN */
    .notes-list { display: flex; flex-direction: column; }
    .note-item { padding: 14px 0; border-bottom: 1px solid #f1f5f9; cursor: pointer; }
    .note-item:last-child { border-bottom: none; }
    .note-title { font-size: 16px; font-weight: 600; color: #1e293b; margin-bottom: 4px; }
    .note-meta { font-size: 13px; color: #94a3b8; font-family: monospace; }
    .note-desc { color: #64748b; margin-left: 6px; font-family: sans-serif; }

    /* Bagian Footer Kartu (...) */
    .card-footer {
        padding: 8px 20px 14px 20px;
        background: #ffffff;
        font-size: 20px;
        color: #64748b;
        font-weight: bold;
        cursor: pointer;
    }
</style>
</head>
<body>

<div class="dashboard-container">

    <!-- KARTU 1: DRIVE -->
    <div class="icloud-card">
        <div class="card-header">
            <div class="header-left">
                <div class="app-icon drive-icon"><i class="fa-solid fa-folder-open"></i></div>
                <div class="app-info">
                    <h2>Drive</h2>
                    <span><i class="fa-regular fa-clock"></i> Terbaru</span>
                </div>
            </div>
        </div>
        <div class="card-body drive-content">
            <div class="upload-zone" onclick="document.getElementById('fileInput').click()">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <p id="uploadStatus">Unggah file pertama Anda</p>
                <input type="file" id="fileInput" style="display:none" onchange="uploadFile(this)">
            </div>
            <div class="file-list" id="fileListContainer">
                <div style="font-size:13px; color:#94a3b8;">Memuat berkas...</div>
            </div>
        </div>
        <div class="card-footer">...</div>
    </div>

    <!-- KARTU 2: CATATAN -->
    <div class="icloud-card">
        <div class="card-header">
            <div class="header-left">
                <div class="app-icon notes-icon"><i class="fa-solid fa-note-sticky"></i></div>
                <div class="app-info">
                    <h2>Catatan</h2>
                    <span><i class="fa-solid fa-folder" style="color:#eab308;"></i> Semua iCloud</span>
                </div>
            </div>
            <div class="header-right">
                <i class="fa-regular fa-pen-to-square"></i>
            </div>
        </div>
        <div class="card-body">
            <div class="notes-list" id="notesContainer">
                <div class="note-meta">Memuat catatan...</div>
            </div>
        </div>
        <div class="card-footer">...</div>
    </div>

</div>

<script>
    // Kredensial Supabase Anda
    const SUPABASE_URL = "https://awlxjzfadktcthbumxle.supabase.co"; 
    const SUPABASE_ANON_KEY = "Sb_publishable_LnE9IH5KKDzdV-gj9tIb6w_uOGVZi4o";

    const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // ==========================================
    // MANAGEMENT LOGIKA FILE (DRIVE)
    // ==========================================
    async function loadFiles() {
        const container = document.getElementById('fileListContainer');
        try {
            const { data, error } = await supabaseClient.storage.from('files').list('', {
                limit: 10,
                sortBy: { column: 'name', order: 'desc' }
            });
            if (error) throw error;

            if (data && data.length > 0) {
                container.innerHTML = data.map(file => {
                    const { data: urlData } = supabaseClient.storage.from('files').getPublicUrl(file.name);
                    return `
                        <div class="file-item">
                            <div class="file-item-left">
                                <i class="fa-regular fa-file"></i>
                                <span>${file.name}</span>
                            </div>
                            <a href="${urlData.publicUrl}" download="${file.name}" target="_blank" class="download-btn">
                                <i class="fa-solid fa-download"></i> Unduh
                            </a>
                        </div>
                    `;
                }).join('');
            } else {
                container.innerHTML = '<div style="font-size:14px; text-align:center; padding:10px;">Belum ada berkas di cloud.</div>';
            }
        } catch (err) {
            console.error(err);
            container.innerHTML = '<div style="font-size:14px; color:#ef4444;">Gagal memuat berkas.</div>';
        }
    }

    async function uploadFile(input) {
        const file = input.files[0];
        if (!file) return;

        const statusText = document.getElementById('uploadStatus');
        statusText.innerText = "Mengunggah... ⏳";

        try {
            const { data, error } = await supabaseClient.storage
                .from('files')
                .upload(file.name, file, { cacheControl: '3600', upsert: true });

            if (error) throw error;
            statusText.innerText = "Berhasil diunggah! ✅";
            setTimeout(() => { statusText.innerText = "Unggah file pertama Anda"; }, 3000);
            loadFiles();
        } catch (err) {
            console.error(err);
            statusText.innerText = "Gagal mengunggah! ❌";
            setTimeout(() => { statusText.innerText = "Unggah file pertama Anda"; }, 3000);
        }
    }

    // ==========================================
    // MANAGEMENT LOGIKA DATA (CATATAN)
    // ==========================================
    async function loadNotes() {
        const container = document.getElementById('notesContainer');
        try {
            let { data: catatan, error } = await supabaseClient
                .from('catatan')
                .select('*')
                .order('id', { ascending: false });

            if (error) throw error;

            if (catatan && catatan.length > 0) {
                container.innerHTML = catatan.map(note => `
                    <div class="note-item">
                        <div class="note-title">${note.title || 'Tanpa Judul'}</div>
                        <div class="note-meta">
                            ${note.date_label || ''} <span class="note-desc">${note.description || 'Tidak ada teks tambahan'}</span>
                        </div>
                    </div>
                `).join('');
            } else {
                container.innerHTML = '<div class="note-meta">Tidak ada catatan ditemukan.</div>';
            }
        } catch (error) {
            console.error(error);
            container.innerHTML = '<div class="note-meta" style="color:#ef4444;">Gagal memuat catatan.</div>';
        }
    }

    // Jalankan sinkronisasi data secara bersamaan ketika web dimuat
    window.onload = () => {
        loadFiles();
        loadNotes();
    };
</script>

</body>
</html>
